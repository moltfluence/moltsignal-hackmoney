# Shared
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/molt_signal"

# Arc / Circle (HackMoney)
ARC_RPC_URL="https://rpc.testnet.arc.network"
ARC_CHAIN_ID="5042002"
# Arc USDC: native gas token (18 decimals) with optional ERC-20 interface.
ARC_USDC_ADDRESS="0x3600000000000000000000000000000000000000"
ARC_USDC_DECIMALS="18"

# Contracts
ESCROW_ADDRESS="0x0000000000000000000000000000000000000000"
ATTESTOR_ADDRESS="0x0000000000000000000000000000000000000000"

# Keys (demo/testnet only)
SPONSOR_PRIVATE_KEY="0x"
RELAYER_PRIVATE_KEY="0x"
ORACLE_PRIVATE_KEY="0x"

# Yellow Network (Nitrolite / @erc7824/nitrolite)
YELLOW_ENABLED="false"
YELLOW_CLEARNODE_WS_URL="wss://clearnet-sandbox.yellow.com/ws"
YELLOW_FAUCET_URL="https://clearnet-sandbox.yellow.com/faucet/requestTokens"
# The Yellow sandbox uses test tokens (e.g. ytest.usd) in an off-chain unified balance.
YELLOW_ASSET_SYMBOL="ytest.usd"
YELLOW_SENDER_PRIVATE_KEY="0x"
YELLOW_PAY_PER_VALID_PROOF_ATOMIC="100000" # example: 0.1 unit @ 6 decimals (token-specific)

# Uniswap v4 (optional treasury actions)
UNISWAP_V4_ENABLED="false"
UNISWAP_V4_CHAIN_ID="11155111"
UNISWAP_V4_RPC_URL="https://sepolia.drpc.org"
UNISWAP_V4_UNIVERSAL_ROUTER_ADDRESS=""
UNISWAP_V4_POOL_MANAGER_ADDRESS=""
UNISWAP_V4_QUOTER_ADDRESS=""
UNISWAP_V4_POSITION_MANAGER_ADDRESS=""
UNISWAP_V4_PERMIT2_ADDRESS="0x000000000022D473030F116dDEE9F6B43aC78BA3"

# Ops
OPERATOR_API_KEY="replace-me"
MOLTBOOK_ALLOWLIST="moltbook.com,www.moltbook.com"
MIN_ACCOUNT_AGE_DAYS="7"
# Optional OpenClaw-style binding overrides for worker stage routing
# JSON array shape:
# [{"agentId":"proof-scout","match":{"campaignId":1,"stage":"ingest-proofs"}}]
ORCHESTRATION_BINDINGS_JSON=""

# Demo runner
APP_BASE_URL="http://localhost:3000"
AGENT_1_PRIVATE_KEY="0x"
AGENT_2_PRIVATE_KEY="0x"
AGENT_3_PRIVATE_KEY="0x"
DEMO_POST_URLS="https://www.moltbook.com/post/1,https://www.moltbook.com/post/2,https://www.moltbook.com/post/3"
